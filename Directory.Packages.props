<Project>
  <!--
    Central Package Management: every NuGet package this repository references is versioned
    here, and the projects name packages without a Version. MSBuild uses the nearest
    Directory.Packages.props walking up from a project, so this file also keeps an in-tree
    checkout of Broiler.Writer independent of any parent workspace's.

    BroilerWriterVersion in Directory.Build.props is the application's own version, not a
    package version, and stays there.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Documents preview.28 removes APIs used by the published UI preview.23 binaries.
         Keep preview.27 until a compatible UI package is published. -->
    <BroilerDocumentsVersion>0.1.0-preview.27</BroilerDocumentsVersion>
    <BroilerHostingVersion>0.1.0-preview.10</BroilerHostingVersion>
    <BroilerGraphicsVersion>0.1.0-preview.14</BroilerGraphicsVersion>
    <BroilerInputVersion>0.1.0-preview.7</BroilerInputVersion>
    <BroilerMediaVersion>0.1.0-preview.16</BroilerMediaVersion>
    <BroilerUiVersion>0.1.0-preview.23</BroilerUiVersion>
    <!-- Printing: the print dialog and preview are in Broiler.UI 0.1.0-preview.22, the paginator in
         Broiler.Documents 0.1.0-preview.25, the page model in Broiler.Graphics 0.1.0-preview.13 and
         the print hosts in Broiler.Hosting 0.1.0-preview.10. Properties, so a build against local
         packs can name them. -->
    <BroilerUiPackageVersion Condition="'$(BroilerUiPackageVersion)' == ''">0.1.0-preview.23</BroilerUiPackageVersion>
    <BroilerDocumentsPackageVersion Condition="'$(BroilerDocumentsPackageVersion)' == ''">0.1.0-preview.27</BroilerDocumentsPackageVersion>
    <BroilerGraphicsPackageVersion Condition="'$(BroilerGraphicsPackageVersion)' == ''">0.1.0-preview.14</BroilerGraphicsPackageVersion>
    <BroilerHostingPackageVersion Condition="'$(BroilerHostingPackageVersion)' == ''">0.1.0-preview.10</BroilerHostingPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Broiler.Documents.Docx" Version="0.1.0-preview.27" />
    <PackageVersion Include="Broiler.Documents.FormatCodes" Version="0.1.0-preview.27" />
    <PackageVersion Include="Broiler.Documents.Html" Version="0.1.0-preview.27" />
    <PackageVersion Include="Broiler.Documents.Markdown" Version="0.1.0-preview.27" />
    <PackageVersion Include="Broiler.Documents.Pagination" Version="0.1.0-preview.27" />
    <PackageVersion Include="Broiler.Documents.Odt" Version="0.1.0-preview.27" />
    <PackageVersion Include="Broiler.Documents.Pdf" Version="0.1.0-preview.27" />
    <PackageVersion Include="Broiler.Documents.Pdf.Fonts" Version="0.1.0-preview.27" />
    <PackageVersion Include="Broiler.Documents.Pdf.Images" Version="0.1.0-preview.27" />
    <PackageVersion Include="Broiler.Documents.Rtf" Version="0.1.0-preview.27" />
    <PackageVersion Include="Broiler.Graphics" Version="$(BroilerGraphicsPackageVersion)" />
    <PackageVersion Include="Broiler.Graphics.Linux" Version="0.1.0-preview.14" />
    <PackageVersion Include="Broiler.Graphics.Linux.OpenGL" Version="0.1.0-preview.14" />
    <PackageVersion Include="Broiler.Graphics.WebAssembly" Version="$(BroilerGraphicsVersion)" />
    <PackageVersion Include="Broiler.Graphics.Windows" Version="0.1.0-preview.14" />
    <PackageVersion Include="Broiler.Hosting.Android" Version="$(BroilerHostingPackageVersion)" />
    <PackageVersion Include="Broiler.Hosting.Linux" Version="$(BroilerHostingPackageVersion)" />
    <PackageVersion Include="Broiler.Hosting.Windows" Version="$(BroilerHostingPackageVersion)" />
    <PackageVersion Include="Broiler.Input.Android" Version="$(BroilerInputVersion)" />
    <PackageVersion Include="Broiler.Input.Keyboard.Android" Version="$(BroilerInputVersion)" />
    <PackageVersion Include="Broiler.Input.Keyboard.Linux" Version="0.1.0-preview.7" />
    <PackageVersion Include="Broiler.Input.Linux" Version="0.1.0-preview.7" />
    <PackageVersion Include="Broiler.Input.Mouse.Linux" Version="0.1.0-preview.7" />
    <PackageVersion Include="Broiler.Input.Pen.Android" Version="$(BroilerInputVersion)" />
    <PackageVersion Include="Broiler.Input.Text.Android" Version="$(BroilerInputVersion)" />
    <PackageVersion Include="Broiler.Input.Touch.Android" Version="$(BroilerInputVersion)" />
    <PackageVersion Include="Broiler.Media.Image" Version="0.1.0-preview.16" />
    <PackageVersion Include="Broiler.Media.Image.Managed" Version="0.1.0-preview.16" />
    <PackageVersion Include="Broiler.UI" Version="$(BroilerUiPackageVersion)" />
    <PackageVersion Include="Broiler.UI.AboutDialog" Version="0.1.0-preview.23" />
    <PackageVersion Include="Broiler.UI.AboutDialog.Standard" Version="0.1.0-preview.23" />
    <PackageVersion Include="Broiler.UI.Button.Standard" Version="0.1.0-preview.23" />
    <PackageVersion Include="Broiler.UI.ComboBox.Standard" Version="0.1.0-preview.23" />
    <PackageVersion Include="Broiler.UI.Dialog.Standard" Version="0.1.0-preview.23" />
    <PackageVersion Include="Broiler.UI.Edit.Standard" Version="0.1.0-preview.23" />
    <PackageVersion Include="Broiler.UI.FileDialog.Standard" Version="0.1.0-preview.23" />
    <PackageVersion Include="Broiler.UI.FontDialog.Standard" Version="0.1.0-preview.23" />
    <PackageVersion Include="Broiler.UI.FormatCodeView" Version="0.1.0-preview.23" />
    <PackageVersion Include="Broiler.UI.FormatCodeView.Standard" Version="0.1.0-preview.23" />
    <PackageVersion Include="Broiler.UI.Label.Standard" Version="0.1.0-preview.23" />
    <PackageVersion Include="Broiler.UI.Menu.Standard" Version="0.1.0-preview.23" />
    <PackageVersion Include="Broiler.UI.PrintDialog.Standard" Version="0.1.0-preview.23" />
    <PackageVersion Include="Broiler.UI.RichEdit" Version="0.1.0-preview.23" />
    <PackageVersion Include="Broiler.UI.RichEdit.Standard" Version="0.1.0-preview.23" />
    <PackageVersion Include="Broiler.UI.Splitter.Standard" Version="0.1.0-preview.23" />
    <PackageVersion Include="Broiler.UI.Toolbar.Standard" Version="0.1.0-preview.23" />
    <PackageVersion Include="Broiler.UI.Tooltip.Standard" Version="0.1.0-preview.23" />
    <PackageVersion Include="Broiler.UI.Window.Standard" Version="0.1.0-preview.23" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>