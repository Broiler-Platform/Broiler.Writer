<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Restore sources for Broiler.Writer.

    <clear /> drops whatever sources the machine happens to have configured, so a restore
    resolves the same way on every developer box and in CI.

    Every package, Broiler.* included, resolves against nuget.org, the one feed the Broiler
    components are published to. There is no GitHub Packages source and nothing to
    authenticate.

    Never commit a token here.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
