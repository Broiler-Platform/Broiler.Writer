<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Broiler.Writer</RootNamespace>
    <AssemblyName>Broiler.Writer.Linux</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <Configurations>Debug;Release;Debug-Linux;Release-Linux</Configurations>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Debug-Linux' Or '$(Configuration)' == 'Release-Linux'">linux-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Broiler.App\LinuxInputCoordinator.cs" Link="LinuxInputCoordinator.cs" />
    <Compile Include="..\Broiler.App\LinuxX11Clipboard.cs" Link="LinuxX11Clipboard.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Broiler.Documents.Pdf" Version="0.1.0-preview.16" />
    <PackageReference Include="Broiler.Documents.Pdf.Images" Version="0.1.0-preview.16" />
    <PackageReference Include="Broiler.Documents.Pdf.Fonts" Version="0.1.0-preview.16" />
    <PackageReference Include="Broiler.Graphics" Version="0.1.0-preview.5" />
    <PackageReference Include="Broiler.Graphics.Linux" Version="0.1.0-preview.5" />
    <PackageReference Include="Broiler.Graphics.Linux.OpenGL" Version="0.1.0-preview.5" />
    <PackageReference Include="Broiler.Input.Keyboard.Linux" Version="0.1.0-preview.5" />
    <PackageReference Include="Broiler.Input.Linux" Version="0.1.0-preview.5" />
    <PackageReference Include="Broiler.Input.Mouse.Linux" Version="0.1.0-preview.5" />
    <PackageReference Include="Broiler.Media.Image.Managed" Version="0.1.0-preview.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.Writer\Broiler.Writer.Core.csproj" />
    <!-- The PDF codec is referenced by the heads that register it, never by the
         shared Writer core: a head must not acquire it transitively (PDF roadmap §10.1). -->
  </ItemGroup>

</Project>
