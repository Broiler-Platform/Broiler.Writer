<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Broiler.Writer</RootNamespace>
    <AssemblyName>Broiler.Writer.Linux</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <Configurations>Debug;Release;Debug-Linux;Release-Linux</Configurations>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Debug-Linux' Or '$(Configuration)' == 'Release-Linux'">linux-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Broiler.Documents.Pdf" />
    <PackageReference Include="Broiler.Documents.Pdf.Images" />
    <PackageReference Include="Broiler.Documents.Pdf.Fonts" />
    <PackageReference Include="Broiler.Graphics" />
    <PackageReference Include="Broiler.Graphics.Linux" />
    <PackageReference Include="Broiler.Graphics.Linux.OpenGL" />
    <!-- The X11 clipboard and evdev input coordination, shared with the other desktop applications. -->
    <PackageReference Include="Broiler.Hosting.Linux" />
    <PackageReference Include="Broiler.Input.Keyboard.Linux" />
    <PackageReference Include="Broiler.Input.Linux" />
    <PackageReference Include="Broiler.Input.Mouse.Linux" />
    <PackageReference Include="Broiler.Media.Image.Managed" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.Writer\Broiler.Writer.Core.csproj" />
    <!-- The PDF codec is referenced by the heads that register it, never by the
         shared Writer core: a head must not acquire it transitively (PDF roadmap §10.1). -->
  </ItemGroup>

</Project>
