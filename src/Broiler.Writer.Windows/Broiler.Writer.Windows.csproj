<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Broiler.Writer</RootNamespace>
    <AssemblyName>Broiler.Writer.Windows</AssemblyName>
    <IsPackable>false</IsPackable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup>
    <Configurations>Debug;Release;Debug-Windows;Release-Windows</Configurations>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Debug-Windows' Or '$(Configuration)' == 'Release-Windows'">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- The Win32 clipboard, shared with the other desktop heads. -->
  <ItemGroup>
    <Compile Include="..\Broiler.App\WindowsClipboard.cs" Link="WindowsClipboard.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Broiler.Documents.Pdf" Version="0.1.0-preview.10" />
    <PackageReference Include="Broiler.Documents.Pdf.Images" Version="0.1.0-preview.10" />
    <PackageReference Include="Broiler.Documents.Pdf.Fonts" Version="0.1.0-preview.10" />
    <PackageReference Include="Broiler.Graphics" Version="0.1.0-preview.4" />
    <PackageReference Include="Broiler.Graphics.Windows" Version="0.1.0-preview.4" />
    <PackageReference Include="Broiler.Media.Image.Managed" Version="0.1.0-preview.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.Writer\Broiler.Writer.Core.csproj" />
    <!-- The PDF codec is referenced by the heads that register it, never by the
         shared Writer core: a head must not acquire it transitively (PDF roadmap §10.1). -->
  </ItemGroup>

</Project>
