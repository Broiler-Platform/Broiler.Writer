<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Broiler.Writer.FormatCodes.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!--
    Components arrive as packages, exactly as they do for the heads. These were
    ProjectReferences into submodule working copies until the move to NuGet
    removed the submodules; a ProjectReference to a path that no longer exists is
    only MSB9008, a warning, so the build carried on and reported the resulting
    absence as thirty-odd CS0234 and CS0246 in the test sources instead.
  -->
  <ItemGroup>
    <!-- Referenced so the tests can compose PDF the way the desktop heads do, and
         assert that the shared default format set still does not carry it. -->
    <PackageReference Include="Broiler.Documents.Pdf" />
    <PackageReference Include="Broiler.Documents.Pdf.Images" />
    <PackageReference Include="Broiler.Documents.Pdf.Fonts" />
    <PackageReference Include="Broiler.UI.RichEdit.Standard" />
    <PackageReference Include="Broiler.Media.Image.Managed" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.Writer.FormatCodes\Broiler.Writer.FormatCodes.csproj" />
    <ProjectReference Include="..\Broiler.Writer\Broiler.Writer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
