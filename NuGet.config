<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Restore sources for Broiler.Writer.

    <clear /> drops whatever sources the machine happens to have configured, so a restore
    resolves the same way on every developer box and in CI.

    Only nuget.org is listed. This repository takes every Broiler dependency through the
    submodules as project references, so nothing here resolves a Broiler.* package and the
    Broiler-Platform GitHub Packages feed is deliberately absent — that feed requires
    authentication even for public packages and would answer 401 for every lookup.

    Never commit a token here.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
