<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Broiler.Writer.FormatCodes.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)Writer.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Components arrive as packages, exactly as they do for the heads. These were
    ProjectReferences into submodule working copies until the move to NuGet
    removed the submodules; a ProjectReference to a path that no longer exists is
    only MSB9008, a warning, so the build carried on and reported the resulting
    absence as thirty-odd CS0234 and CS0246 in the test sources instead.
  -->
  <ItemGroup>
    <!-- Referenced so the tests can compose PDF the way the desktop heads do, and
         assert that the shared default format set still does not carry it. -->
    <PackageReference Include="Broiler.Documents.Pdf" />
    <PackageReference Include="Broiler.Documents.Pdf.Images" />
    <PackageReference Include="Broiler.Documents.Pdf.Fonts" />
    <PackageReference Include="Broiler.UI.RichEdit.Standard" Condition="'$(UseBroilerUiSource)' != 'true'" />
    <ProjectReference Include="$(BroilerUiSourceRoot)\src\Implementations\Standard\Text\Broiler.UI.RichEdit.Standard\Broiler.UI.RichEdit.Standard.csproj" Condition="'$(UseBroilerUiSource)' == 'true'" />
    <PackageReference Include="Broiler.Media.Image.Managed" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.Writer.FormatCodes\Broiler.Writer.FormatCodes.csproj" />
    <ProjectReference Include="..\Broiler.Writer\Broiler.Writer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="../Broiler.Writer.WebAssembly/BrowserDocumentState.cs" Link="BrowserDocumentState.cs" />
    <Compile Include="../Broiler.Writer.WebAssembly/BrowserImageBudget.cs" Link="BrowserImageBudget.cs" />
    <Compile Include="../Broiler.Writer.WebAssembly/BrowserPdfDocuments.cs" Link="BrowserPdfDocuments.cs" />
  </ItemGroup>

</Project>
