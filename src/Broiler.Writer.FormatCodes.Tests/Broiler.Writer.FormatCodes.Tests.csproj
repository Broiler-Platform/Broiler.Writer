<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Broiler.Writer.FormatCodes.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <!--
    Components arrive as packages, exactly as they do for the heads. These were
    ProjectReferences into submodule working copies until the move to NuGet
    removed the submodules; a ProjectReference to a path that no longer exists is
    only MSB9008, a warning, so the build carried on and reported the resulting
    absence as thirty-odd CS0234 and CS0246 in the test sources instead.
  -->
  <ItemGroup>
    <!-- Referenced so the tests can compose PDF the way the desktop heads do, and
         assert that the shared default format set still does not carry it. -->
    <PackageReference Include="Broiler.Documents.Pdf" Version="0.1.0-preview.16" />
    <PackageReference Include="Broiler.Documents.Pdf.Images" Version="0.1.0-preview.16" />
    <PackageReference Include="Broiler.Documents.Pdf.Fonts" Version="0.1.0-preview.16" />
    <PackageReference Include="Broiler.UI.RichEdit.Standard" Version="0.1.0-preview.8" />
    <PackageReference Include="Broiler.Media.Image.Managed" Version="0.1.0-preview.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.Writer.FormatCodes\Broiler.Writer.FormatCodes.csproj" />
    <ProjectReference Include="..\Broiler.Writer\Broiler.Writer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
