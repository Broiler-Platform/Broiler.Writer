<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Restore sources for Broiler.Writer.

    <clear /> drops whatever sources the machine happens to have configured, so a restore
    resolves the same way on every developer box and in CI.

    Broiler.* packages resolve against the GitHub Packages feed for Broiler-Platform.
    General packages resolve against nuget.org.
    Authentication for GitHub Packages is provided in CI or local NuGet credentials.

    Never commit a token here.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="GitHub Broiler" value="https://nuget.pkg.github.com/Broiler-Platform/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="GitHub Broiler">
      <package pattern="Broiler.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
